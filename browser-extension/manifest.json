{
  "manifest_version": 3,
  "name": "Shellby Browser Bridge",
  "version": "0.2.0",
  "description": "Lets your local Shellby MCP server drive tabs in the Shellby tab group, on sites you approve.",
  "key": "",
  "minimum_chrome_version": "125",
  "permissions": ["alarms", "debugger", "storage", "tabGroups", "tabs"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Shellby" }
}
